# Local storage (used when S3_ENDPOINT_URL is empty)
DATA_DIR=bitcoin_pipeline/data
DUCKDB_PATH=bitcoin_pipeline/data/bitcoin_pipeline.duckdb

# --- Bronze storage target -------------------------------------------------
# Single switch: leave S3_ENDPOINT_URL EMPTY to write/read Bronze on local disk.
# Set it (+ credentials) to use MinIO / S3-compatible object storage instead.
#
# The Airflow Docker stack sets these automatically (see docker-compose.airflow.yml)
# to point at the bundled MinIO service. Fill them here only if you want the local
# runner / local dbt to use MinIO too.
#
#   MinIO (local):  S3_ENDPOINT_URL=http://localhost:9000
#                   AWS_ACCESS_KEY_ID=minioadmin
#                   AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=bitcoin-pipeline-bronze
AWS_REGION=ap-southeast-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
